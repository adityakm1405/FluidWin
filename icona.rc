1 ICON "icona.ico"

// sfondi di FluidWin (sfondi.h): JPG 3840x2160 dentro l'exe, estratti quando si sceglie uno nelle impostazioni
201 RCDATA "sfondi/colline.jpg"
202 RCDATA "sfondi/seta.jpg"
203 RCDATA "sfondi/pastello.jpg"

 // Built-in dock icon replacements, embedded so an EXE-only update is sufficient.
204 RCDATA "assets/icons8-mac-logo-480.png"
205 RCDATA "assets/icons8-bin-windows-240.svg"
206 RCDATA "assets/trash-windows11.svg"
207 RCDATA "assets/trash-macos.svg"
208 RCDATA "assets/download-default.svg"
209 RCDATA "assets/download-original-source.png"
210 RCDATA "assets/pushpin-outline-white.svg"
211 RCDATA "assets/pushpin-filled-white.svg"

1 VERSIONINFO
FILEVERSION     1,3,1,0
PRODUCTVERSION  1,3,1,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004B0"
        BEGIN
            VALUE "CompanyName",      "Clooudy"
            VALUE "FileDescription",  "FluidWin"
            VALUE "FileVersion",      "1.3.1"
            VALUE "InternalName",     "FluidWin"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Clooudy - licenza MIT"
            VALUE "OriginalFilename", "FluidWin.exe"
            VALUE "ProductName",      "FluidWin"
            VALUE "ProductVersion",   "1.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0410, 1200
    END
END
